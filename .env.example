# ============================================================
# INJ Watermark 环境变量模板
# 使用方法：复制本文件为 .env，然后填入你自己的值
# 注意：.env 已加入 .gitignore，绝对不要提交到 GitHub！
# ============================================================

# --- Injective 测试网钱包 ---
# ⚠️  任选一种签名方式：助记词 或 私钥十六进制
# ⚠️  生产环境请用环境变量注入，不要明文写在文件里！
# 你的助记词（12 或 24 个单词，用空格分隔）——不使用助记词就保持注释/空
MNEMONIC=""
# 你的私钥十六进制（64 位）——不使用私钥就保持注释/空
PRIVATE_KEY_HEX=""

# 你的 Injective 地址（Bech32，inj1 开头）
OWNER_ADDRESS="inj1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- 已部署的合约地址（Testnet）---
# 你之前部署的版权存证合约（如果还没部署先留空）
CONTRACT_ADDRESS=""

# --- 网络配置 ---
# 可选：testnet / mainnet / local
NETWORK="testnet"

# Gas 价格（testnet 建议 25Gwei，不用改）
GAS_PRICE="25000000000"
